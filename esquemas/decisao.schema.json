{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decisao.schema.json",
  "title": "Entrada do Registro de Decisões",
  "description": "Saída da habilidade registrar-decisao (plano, item 8). Registra a essência confirmada por Vicente e a diretriz; a fala original fica só na trilha, por referência. As palavras ambíguas conferidas ficam anotadas.",
  "type": "object",
  "required": ["id", "data", "essencia", "diretriz", "confirmada_por_vicente", "fala_original_ref", "palavras_conferidas"],
  "properties": {
    "id": {"type": "string", "pattern": "^D-[0-9]{3}$"},
    "data": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "essencia": {"type": "string", "minLength": 1},
    "diretriz": {"type": "string", "minLength": 1},
    "confirmada_por_vicente": {"const": true},
    "data_confirmacao": {"type": "string"},
    "fala_original_ref": {"type": "string", "minLength": 1, "description": "Onde a fala original está na trilha (arquivo e linha, ou commit); nunca a transcrição."},
    "palavras_conferidas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["palavra", "sentido_confirmado"],
        "properties": {"palavra": {"type": "string"}, "sentido_confirmado": {"type": "string"}}
      }
    },
    "substitui": {"type": "string"},
    "marcador": {"enum": ["VIGENTE", "PROPOSTA"]}
  }
}
