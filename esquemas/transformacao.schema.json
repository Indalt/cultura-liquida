{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "transformacao.schema.json",
  "title": "Transformação",
  "description": "Transformação do §6 (l. 609): a relação entre duas Compreensões locais de períodos diferentes, autóctone ou por interação (D-018). Os campos de origem (l. 587) sempre; os de proteção (l. 586) obrigatórios nos contratos que tocam pessoa, comunidade ou texto de terceiro por natureza e permitidos em todos, para o registro que os tocar. Retirada (l. 585): com retirado = true, só id, origem e fundido_em, sem o conteúdo. Nenhum campo a mais (additionalProperties: false). Valores provisórios por $ref a esquemas/valores-provisorios.json. Versão 0.1.0 (22/10/2026, K-104).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "origem_registro"
  ],
  "properties": {
    "id": {
      "$ref": "valores-provisorios.json#/valores/prefixos_id/valor/padroes/TF"
    },
    "de": {
      "$ref": "valores-provisorios.json#/valores/prefixos_id/valor/padroes/CP"
    },
    "para": {
      "$ref": "valores-provisorios.json#/valores/prefixos_id/valor/padroes/CP"
    },
    "tipo": {
      "enum": [
        "autóctone",
        "por interação"
      ]
    },
    "interacao_com": {
      "type": "string",
      "minLength": 1
    },
    "lugares": {
      "type": "array",
      "items": {
        "$ref": "valores-provisorios.json#/valores/prefixos_id/valor/padroes/LU"
      },
      "uniqueItems": true
    },
    "evidencias": {
      "type": "array",
      "items": {
        "$ref": "valores-provisorios.json#/valores/prefixos_id/valor/padroes/EV"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "protecao": {
      "$ref": "comum.schema.json#/$defs/protecao"
    },
    "origem_registro": {
      "$ref": "comum.schema.json#/$defs/origem_registro"
    },
    "retirado": {
      "type": "boolean"
    },
    "fundido_em": {
      "type": "string",
      "pattern": "^[A-Z]{1,2}-[0-9]{4,}$"
    },
    "nota": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "retirado": {
            "const": true
          }
        },
        "required": [
          "retirado"
        ]
      },
      "then": {
        "propertyNames": {
          "enum": [
            "id",
            "retirado",
            "fundido_em",
            "origem_registro",
            "nota"
          ]
        }
      },
      "else": {
        "required": [
          "de",
          "para",
          "tipo",
          "lugares",
          "evidencias"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "tipo": {
                  "const": "por interação"
                }
              },
              "required": [
                "tipo"
              ]
            },
            "then": {
              "required": [
                "interacao_com"
              ]
            }
          }
        ]
      }
    }
  ]
}
