{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lugar.schema.json",
  "title": "Lugar",
  "description": "Lugar do §6 (l. 614). A ligação ao município atual só sem ambiguidade, com o ano da divisão territorial e o período de validade do topônimo; ambíguo → Falta. Todo atributo derivado traz fonte, edição e data. Não é uma 5ª dimensão: é a situação da CLB e a âncora de W. Os campos de origem (l. 587) sempre; os de proteção (l. 586) obrigatórios nos contratos que tocam pessoa, comunidade ou texto de terceiro por natureza e permitidos em todos, para o registro que os tocar. Retirada (l. 585): com retirado = true, só id, origem e fundido_em, sem o conteúdo. Nenhum campo a mais (additionalProperties: false). Valores provisórios por $ref a esquemas/valores-provisorios.json. Versão 0.1.0 (22/10/2026, K-104).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "origem_registro"
  ],
  "properties": {
    "id": {
      "$ref": "valores-provisorios.json#/valores/prefixos_id/valor/padroes/LU"
    },
    "nivel": {
      "enum": [
        "UF",
        "município",
        "localidade",
        "bioma",
        "território tradicional",
        "região cultural",
        "região imediata",
        "distrito",
        "outro"
      ]
    },
    "nome_na_fonte": {
      "type": "string",
      "minLength": 1
    },
    "municipio_atual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geocodigo_ibge",
        "ano_divisao",
        "validade_toponimo"
      ],
      "properties": {
        "geocodigo_ibge": {
          "type": "string",
          "pattern": "^[0-9]{7}$"
        },
        "ano_divisao": {
          "type": "integer"
        },
        "validade_toponimo": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "falta_ligacao": {
      "$ref": "valores-provisorios.json#/valores/prefixos_id/valor/padroes/F"
    },
    "derivados": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "atributo",
          "valor",
          "fonte",
          "edicao",
          "data"
        ],
        "properties": {
          "atributo": {
            "type": "string",
            "minLength": 1
          },
          "valor": {
            "type": "string",
            "minLength": 1
          },
          "fonte": {
            "type": "string",
            "minLength": 1
          },
          "edicao": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "$ref": "comum.schema.json#/$defs/data"
          }
        }
      }
    },
    "fonte_nomeia": {
      "anyOf": [
        {
          "$ref": "valores-provisorios.json#/valores/prefixos_id/valor/padroes/FO"
        },
        {
          "$ref": "valores-provisorios.json#/valores/prefixos_id/valor/padroes/EV"
        }
      ]
    },
    "protecao": {
      "$ref": "comum.schema.json#/$defs/protecao"
    },
    "origem_registro": {
      "$ref": "comum.schema.json#/$defs/origem_registro"
    },
    "retirado": {
      "type": "boolean"
    },
    "fundido_em": {
      "type": "string",
      "pattern": "^[A-Z]{1,2}-[0-9]{4,}$"
    },
    "nota": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "retirado": {
            "const": true
          }
        },
        "required": [
          "retirado"
        ]
      },
      "then": {
        "propertyNames": {
          "enum": [
            "id",
            "retirado",
            "fundido_em",
            "origem_registro",
            "nota"
          ]
        }
      },
      "else": {
        "required": [
          "nivel",
          "nome_na_fonte",
          "protecao"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "nivel": {
                  "enum": [
                    "território tradicional",
                    "região cultural"
                  ]
                }
              },
              "required": [
                "nivel"
              ]
            },
            "then": {
              "required": [
                "fonte_nomeia"
              ]
            }
          },
          {
            "not": {
              "required": [
                "municipio_atual",
                "falta_ligacao"
              ]
            }
          }
        ]
      }
    }
  ]
}
