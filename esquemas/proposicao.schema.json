{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proposicao.schema.json",
  "title": "Proposição",
  "description": "Proposição do §6 (l. 602): CLB situada × atributo × valor × período. μ e λ calculados por script e contados por linhagem (Passo 7); null e sem o campo estado (eixo 4) até o cálculo, porque o eixo 4 não tem valor de 'não calculado' (l. 627). A fonte contrária entra como Evidência divergente e não derruba a Proposição (D-019). Os campos de origem (l. 587) sempre; os de proteção (l. 586) obrigatórios nos contratos que tocam pessoa, comunidade ou texto de terceiro por natureza e permitidos em todos, para o registro que os tocar. Retirada (l. 585): com retirado = true, só id, origem e fundido_em, sem o conteúdo. Nenhum campo a mais (additionalProperties: false). Valores provisórios por $ref a esquemas/valores-provisorios.json. Versão 0.1.0 (22/10/2026, K-104).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "origem_registro"
  ],
  "properties": {
    "id": {
      "$ref": "valores-provisorios.json#/valores/prefixos_id/valor/padroes/PR"
    },
    "clb": {
      "$ref": "valores-provisorios.json#/valores/prefixos_id/valor/padroes/CL"
    },
    "atributo": {
      "type": "string",
      "minLength": 1,
      "description": "insumo, processo, recipiente, lugar, época, transmissão, uso, risco… (D-017: exemplos não limitam)"
    },
    "valor": {
      "type": "string",
      "minLength": 1
    },
    "periodo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referido"
      ],
      "properties": {
        "referido": {
          "type": "string",
          "minLength": 1,
          "description": "o período a que a fonte se refere (Z; P9)"
        },
        "data_fonte": {
          "type": "string",
          "description": "a data da fonte (P9), quando difere"
        }
      }
    },
    "evidencias": {
      "type": "array",
      "items": {
        "$ref": "valores-provisorios.json#/valores/prefixos_id/valor/padroes/EV"
      },
      "uniqueItems": true
    },
    "mu": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "lambda": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "estado": {
      "$ref": "valores-provisorios.json#/estrutura/eixos/eixo4/esquema"
    },
    "estado_detalhe": {
      "type": "string",
      "description": "o nome do estado intermediário"
    },
    "sustenta_aviso_saude_politica": {
      "type": "boolean",
      "description": "marca posta na triagem; o auditor lê todos os marcados, fora da amostra (D-038; l. 473)"
    },
    "versao_regra": {
      "type": "string",
      "pattern": "^mu-lambda-[0-9]+\\.[0-9]+$"
    },
    "protecao": {
      "$ref": "comum.schema.json#/$defs/protecao"
    },
    "origem_registro": {
      "$ref": "comum.schema.json#/$defs/origem_registro"
    },
    "retirado": {
      "type": "boolean"
    },
    "fundido_em": {
      "type": "string",
      "pattern": "^[A-Z]{1,2}-[0-9]{4,}$"
    },
    "nota": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "retirado": {
            "const": true
          }
        },
        "required": [
          "retirado"
        ]
      },
      "then": {
        "propertyNames": {
          "enum": [
            "id",
            "retirado",
            "fundido_em",
            "origem_registro",
            "nota"
          ]
        }
      },
      "else": {
        "required": [
          "clb",
          "atributo",
          "valor",
          "periodo",
          "evidencias",
          "mu",
          "lambda",
          "sustenta_aviso_saude_politica"
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "estado"
              ]
            },
            "then": {
              "required": [
                "versao_regra"
              ],
              "properties": {
                "mu": {
                  "type": "number"
                },
                "lambda": {
                  "type": "number"
                }
              }
            }
          }
        ]
      }
    }
  ]
}
